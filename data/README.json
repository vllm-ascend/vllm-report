{
  "project": "vllm-report",
  "version": 1,
  "description": "vLLM commit analysis and architecture knowledge base for AI Agent. Supports vllm-ascend code upgrades and main2main adaptation.",
  "available_repos": ["vllm-project/vllm", "vllm-project/vllm-ascend"],
  "entry_points": {
    "architecture_context": "data/{repo}/context/architecture.json",
    "commit_index": "data/{repo}/index.json",
    "daily_analysis": "data/{repo}/analysis/{date}.json",
    "adaptation_status": "data/vllm-ascend/adaptation-status.json"
  },
  "docs": [
    "docs/usage-guide.md",
    "docs/data-spec.md"
  ]
}